{
  "name": "sorb-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Reference app for Sorb, the design-token bridge for your running app — every control renders from a CSS custom property.",
  "type": "module",
  "scripts": {
    "sorb": "sorb dev",
    "demo": "node scripts/demo.mjs",
    "tokens": "style-dictionary build --config ./sd.config.js",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "test": "node --test sd/"
  },
  "dependencies": {
    "@metatoy/bootstrap-styled": "^1.0.0",
    "@sorb/leaf": "^0.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@sorb/juice": "^0.2.0",
    "@sorb/seed": "^0.2.0",
    "@sorb/storybook": "^0.1.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.0",
    "storybook": "^8.6.0",
    "style-dictionary": "^4.0.0",
    "vite": "^5.4.0"
  }
}
